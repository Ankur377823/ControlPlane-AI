# ControlPlane AI — Environment Configuration Blueprint Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env — only .env.example should be in version control.

# --- Server & Database Paths ---
PORT=8000
BOTPRESS_CONNECTOR_DB=botpress_connector.db
FRONTEND_DIST=./frontend/dist

# --- Cloud Database (Optional PostgreSQL / Neon) ---
# DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- AI Judges & Guardrails (Optional API Keys) ---
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
# SERPER_API_KEY=your-serper-api-key

# --- Security & Guardian Tokens ---
GUARDIAN_REQUIRE_AUTH=true
# TASK_TOKEN_SECRET=your-custom-hmac-secret

# --- Botpress Cloud Connector (Optional Webhook ID) ---
# WEBHOOK_ID=your-botpress-webhook-id
