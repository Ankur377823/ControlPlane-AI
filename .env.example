# Copy this file to .env and fill in your real Botpress Cloud values.
# Never commit .env -- only .env.example should be in version control.

# --- Botpress (used for live demo / smoke test, via the UI onboarding form) ---
# Get this from Botpress Studio -> your bot -> Integrations -> Chat -> Webhook ID
WEBHOOK_ID=your-botpress-chat-webhook-id

# Optional: only set these if you enabled "manual auth" on the Chat integration
ENCRYPTION_KEY=
USER_ID=

# --- Backend ---
# Path to the SQLite database file (created automatically on first run)
BOTPRESS_CONNECTOR_DB=botpress_connector.db

# Directory containing the built/static frontend served at "/" by FastAPI.
# Defaults to ../frontend relative to backend/app/main.py if unset.
FRONTEND_DIST=

# --- Auth ---
# This demo ships with NO authentication (see README.md "Auth" section and
# EVALUATOR.md). If you add auth, document the required env vars here, e.g.:
# API_KEY=
