# ControlPlane AI — Environment Configuration Blueprint Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env — only .env.example should be in version control.

# --- Server & Database Paths ---
PORT=8000
BOTPRESS_CONNECTOR_DB=botpress_connector.db
FRONTEND_DIST=./frontend/dist

# --- Cloud Database (Optional PostgreSQL / Neon) ---
# DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- AI Judges & Guardrails (Optional API Keys) ---
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
# SERPER_API_KEY=your-serper-api-key

# --- Security & Guardian Tokens ---
GUARDIAN_REQUIRE_AUTH=true
# TASK_TOKEN_SECRET=your-custom-hmac-secret

# --- User 1: Super Admin Credentials ---
# ADMIN_USERNAME=your-admin-username
# ADMIN_EMAIL=your-admin-email@domain.com
# ADMIN_PASSWORD=your-admin-password
# ADMIN_NAME=Your Admin Name

# --- User 2: Operator 1 Credentials ---
# USER1_USERNAME=operator1
# USER1_EMAIL=operator1@domain.com
# USER1_PASSWORD=your-operator1-password
# USER1_NAME=Operator One Name

# --- User 3: Operator 2 Credentials ---
# USER2_USERNAME=operator2
# USER2_EMAIL=operator2@domain.com
# USER2_PASSWORD=your-operator2-password
# USER2_NAME=Operator Two Name

# --- Botpress Cloud Connector (Optional Webhook ID) ---
# WEBHOOK_ID=your-botpress-webhook-id



