{
  "manifest_version": 3,
  "name": "ControlPlane AI Guardrail",
  "version": "1.2.0",
  "description": "Real-time enterprise AI security, PII redaction, and prompt injection guardrail exclusively for AI chatbots (ChatGPT, Claude, Gemini, DeepSeek, Kimi, Perplexity, Copilot, Mistral, Poe).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ControlPlane AI Guardrail Status",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*",
        "https://kimi.moonshot.cn/*",
        "https://*.kimi.ai/*",
        "https://www.perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://*.copilot.microsoft.com/*",
        "https://poe.com/*",
        "https://chat.mistral.ai/*",
        "https://chat.groq.com/*",
        "https://huggingface.co/chat/*",
        "https://*.botpress.cloud/*",
        "https://*.botpress.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
